# ============================================================
# RakeGlossary — Root .gitignore
# ============================================================

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Python ---
__pycache__/
*.py[cod]
*.so
.Python
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
venv*/
.venv/
ENV/
env/

# Test / type-check caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/coverage/
frontend/.vite/
*.local

# --- Runtime data (RakeGlossary) ---
data/
backend/data/
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# --- Secrets / Env ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Backups & scratch files ---
*.bak
*.backup

# --- PyInstaller ---
backend/build/
backend/dist/
*.before-*